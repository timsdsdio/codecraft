{
  "name": "codecraft",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --filter @codecraft/bladecraft dev",
    "codecraft": "pnpm --parallel --filter @codecraft/todo --filter @codecraft/game dev",
    "wiki": "pnpm --filter @codecraft/wiki dev",
    "test": "pnpm -r test",
    "build": "pnpm --filter @codecraft/bladecraft --filter @codecraft/todo --filter @codecraft/game --filter @codecraft/wiki build",
    "start": "node server/serve.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22"
  }
}
